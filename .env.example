APP_NAME=Temu PBN Automation
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local Docker PostgreSQL. Replace the example password before first start.
POSTGRES_DB=temu_pbn
POSTGRES_USER=temu_pbn
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://temu_pbn:change-me-local-only@localhost:5432/temu_pbn

# Nested settings use a double underscore.
PRICING__TARGET_MARGIN=0.35
PRICING__MIN_MARGIN=0.30
PRICING__DEFAULT_CURRENCY=CNY
PRICING__REQUIRE_DRY_RUN=true

IMPORTS__FACTORY_QUOTE_CURRENCY=CNY

# Add both values together before committing a complete CNY unit-cost calculation.
# Keep the rate and timestamp together so every calculation is reproducible.
# COSTING__USD_CNY_EXCHANGE_RATE=7.00000000
# COSTING__EXCHANGE_RATE_TIMESTAMP=2026-09-21T00:00:00+08:00
COSTING__ESTIMATED_SHIPPING_COST_USD=4.00

# Optional runtime overrides for validation-report rendering.
REPORTS__NODE_EXECUTABLE=node

# Fangguo merchant API. Keep the real key only in the untracked .env file.
FANGGUO__BASE_URL=https://open.fangguo.com/fgapp/openapi
# FANGGUO__API_KEY=replace-with-the-key-from-fangguo
FANGGUO__PLATFORM_TYPE=225
FANGGUO__PAGE_SIZE=100
FANGGUO__ROLLING_LOOKBACK_MINUTES=180

# Sorftime Temu market-data API. Never commit the real Account-SK.
SORFTIME__BASE_URL=https://standardapi.sorftime.com/api
# SORFTIME__ACCOUNT_SK=replace-with-your-account-sk
SORFTIME__DOMAIN=701
SORFTIME__REQUEST_BUDGET=50
# Keep false until a reviewed command is intentionally executed.
SORFTIME__LIVE_REQUESTS_ENABLED=false
SORFTIME__CACHE_DIR=data/processed/sorftime
SORFTIME__CACHE_TTL_HOURS=24
